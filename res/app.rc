#include <winres.h>
#include "../src/version.h"

1 ICON "app.ico"
1 RT_MANIFEST "app.manifest"

// The Stream Deck plugin and its manifest, installed from Settings
// (src\streamdeck.cpp). build.cmd builds the plugin first.
2 RCDATA "../obj/UsageOne.StreamDeck.exe"
3 RCDATA "../streamdeck/manifest.json"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,0
 PRODUCTVERSION VERSION_MAJOR,VERSION_MINOR,VERSION_PATCH,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Jaizu"
            VALUE "FileDescription", "UsageOne"
            VALUE "FileVersion", APP_VERSION_A
            VALUE "InternalName", "UsageOne"
            VALUE "OriginalFilename", "UsageOne.exe"
            VALUE "ProductName", "UsageOne"
            VALUE "ProductVersion", APP_VERSION_A
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
